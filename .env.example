# Copy to procqc/.env (or .env in the working directory) and fill in. Never commit the filled file.

# Fuelix (OpenAI-compatible): text calls and frame / crop calls
FUELIX_API_KEY=
FUELIX_BASE_URL=https://api.fuelix.ai/v1
PROCQC_TEXT_MODEL=gemini-3.8-flash

# Google AI Studio: native video input (narration and verifier clips)
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.8-flash
GOOGLE_VIDEO_FPS=5

# Call behaviour
PROCQC_CALL_TIMEOUT=180
PROCQC_MAX_RETRIES=4
# Response cache directory (default procqc/.llm_cache; set it empty to disable the cache)
# PROCQC_LLM_CACHE_DIR=
