# Copy to procqc/.env (or .env in the working directory) and fill in. Never commit the filled file.

# Fuelix (OpenAI-compatible): text calls and frame / crop calls
FUELIX_API_KEY=
FUELIX_BASE_URL=https://api.fuelix.ai/v1
PROCQC_TEXT_MODEL=gemini-3.8-flash

# Google AI Studio: native video input (narration and verifier clips)
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.8-flash
GOOGLE_VIDEO_FPS=5

# Call behaviour
PROCQC_CALL_TIMEOUT=180
PROCQC_MAX_RETRIES=4
# Response cache directory (default procqc/.llm_cache; set it empty to disable the cache)
# PROCQC_LLM_CACHE_DIR=

# Internal data (procqc.internal; pip install -e .[internal]). Read-only database users. Leave empty if unused.
# FTS: reviewer scores per recording; DATAQC and AUTOQC: QC results joined to them
FTS_HOST=
FTS_PORT=5432
FTS_USER=
FTS_PASS=
FTS_DATABASE=
DATAQC_HOST=
DATAQC_PORT=5432
DATAQC_USER=
DATAQC_PASS=
DATAQC_DATABASE=
AUTOQC_HOST=
AUTOQC_PORT=5432
AUTOQC_USER=
AUTOQC_PASS=
AUTOQC_DATABASE=
# Internal resource names (kept out of the code). FTS_SCHEMA defaults to public.
FTS_WORKFLOW_ID=
FTS_SCHEMA=
AUTOQC_TASKS_TABLE=
DATAQC_RECORDS_TABLE=
S3_BUCKET=
# S3 clip download (procqc.internal.s3_fetch); without these the standard AWS chain or --profile is used
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
